# ── DIRECTORY LISTINGS ──────────────────────────────────────
# Off everywhere. XAMPP ships with Indexes on, which listed every photo and
# export under /uploads/ to anyone who opened the folder's URL.
Options -Indexes

# ── SECURITY HEADERS ────────────────────────────────────────
<IfModule mod_headers.c>
    Header always set X-Frame-Options "DENY"

    Header always set X-Content-Type-Options "nosniff"

    Header always set Referrer-Policy "strict-origin-when-cross-origin"

    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; connect-src 'self'"
</IfModule>

# ── CACHING ─────────────────────────────────────────────────
# Pages and the service worker are revalidated on every request. With no
# Cache-Control header the browser falls back to heuristic caching and can
# reuse a page from before a deploy — which looks exactly like the change
# never shipped. Scripts, styles, images and fonts are deliberately left
# alone: the service worker versions those by its CACHE name.
<IfModule mod_headers.c>
    <FilesMatch "\.html$">
        Header always set Cache-Control "no-cache, must-revalidate"
    </FilesMatch>
    <Files "sw.js">
        Header always set Cache-Control "no-cache, must-revalidate"
    </Files>
</IfModule>
