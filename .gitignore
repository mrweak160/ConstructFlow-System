# ConstructFlow — files that must never reach GitHub

# Real credentials
config/secrets.php
config/db.php

# Local mail log (contains verification codes)
storage/

# Uploaded inspection photos and generated exports
uploads/photos/*
uploads/reports/*
!uploads/photos/.gitkeep
!uploads/reports/.gitkeep

# Composer
vendor/

# Diagnostic — must not be deployed
mailtest.php

# Editor / OS noise
.vscode/
.idea/
.DS_Store
Thumbs.db
